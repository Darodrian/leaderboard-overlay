# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twitch EventSub / OAuth
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_WEBHOOK_SECRET=
TWITCH_CHAT_BOT_TOKEN=
# Optional: must match the Twitch app callback exactly (defaults to <origin>/api/auth/twitch/callback)
TWITCH_REDIRECT_URI=

# 32-byte base64 key used to encrypt stored Twitch access tokens
TOKEN_ENCRYPTION_KEY=

# Public app origin (used to build OBS overlay URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
