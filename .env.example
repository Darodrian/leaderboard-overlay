# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twitch EventSub / OAuth
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_WEBHOOK_SECRET=

# Chat bot secret (for /api/webhooks/chat and /api/overlay/command)
CHAT_BOT_SECRET=

# 32-byte base64 key used to encrypt stored Twitch access tokens
TOKEN_ENCRYPTION_KEY=

# Public app origin (used to build OBS overlay URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
